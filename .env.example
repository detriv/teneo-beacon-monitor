# Teneo Beacon Monitor — Environment Configuration
# Copy this file to ~/.config/teneo-beacon/bot.env and fill in your values.
# OR set these as environment variables in your deployment.

# ============================================================
# Required: Teneo Protocol Auth
# ============================================================
# Bearer token from hub.teneo.pro (extract from browser devtools
# after logging in → Network tab → Authorization header)
TENEO_AUTH_TOKEN=

# ============================================================
# Optional: Teneo API (defaults shown)
# ============================================================
TENEO_API_URL=https://gateway.teneo.pro/api/user/beacon
TENEO_ORIGIN=https://hub.teneo.pro
TENEO_REFERER=https://hub.teneo.pro/

# ============================================================
# Monitor Settings
# ============================================================
# How often to check cooldown (seconds) — default: 3600 (1 hour)
CHECK_INTERVAL_SECONDS=3600

# Data directory for state files (relative to project root)
# Default: ./data/ — change if you want external persistence
DATA_DIR=./data

# ============================================================
# Telegram Notifications (optional but recommended)
# ============================================================
# Create bot with @BotFather → get token
TELEGRAM_BOT_TOKEN=

# Get your chat ID: message @userinfobot or visit https://t.me/getmyid_bot
TELEGRAM_CHAT_ID=

# Set to true to enable Telegram notifications
TELEGRAM_ENABLED=true

# ============================================================
# Webhook Notifications (optional — Discord, custom, etc.)
# ============================================================
# e.g. Discord webhook URL: https://discord.com/api/webhooks/...
WEBHOOK_URL=
WEBHOOK_ENABLED=false

# ============================================================
# Server Settings
# ============================================================
# NOTE: FastAPI Cloud automatically sets HOST and PORT at runtime.
# Do NOT set these as environment variables in FastAPI Cloud.
# For local development, defaults are HOST=0.0.0.0, PORT=8765.
